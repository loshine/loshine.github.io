---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, listingRoutes, dateLabel } from '../lib/posts';

export async function getStaticPaths() { return listingRoutes(await getPosts()); }
const { title, posts, page, pages, base } = Astro.props;
const all = await getPosts();
const isHome = base === '' && page === 1;
const pageUrl = (number: number) => number === 1 ? `/${base ? `${base}/` : ''}` : `/${base ? `${base}/` : ''}page/${number}/`;
const years = [...new Set(all.map((post) => dateLabel(post).slice(0, 4)))];
---
<Base title={isHome ? undefined : `${title}${page > 1 ? ` · 第 ${page} 页` : ''}`}>
  {isHome ? <section class="hero">
    <h1>你好，我是 Loshine。</h1>
    <p>活捉一只 Android 狗。<br />记录 Android、Kotlin 与跨平台开发，也写折腾中的发现和日常。</p>
    <p class="social-links">在这里找到我：<a href="https://github.com/loshine">GitHub ↗</a><a href="/about/">关于我 →</a></p>
  </section> : <header class="page-heading"><h1>{title}</h1></header>}
  <div class="section-heading"><h2>{isHome ? '最近文章' : '文章列表'}</h2><span>{isHome ? `${all.length} 篇笔记 · 持续积累` : `第 ${page} / ${pages} 页`}</span></div>
  {base.startsWith('archives') && <nav class="archive-years" aria-label="按年份归档">{years.map((year) => <a href={`/archives/${year}/`}>{year}</a>)}</nav>}
  <PostList posts={posts} />
  {pages > 1 && <nav class="pagination" aria-label="文章分页">
    {page > 1 ? <a rel="prev" href={pageUrl(page - 1)}>← 上一页</a> : <span />}
    <span>{page} / {pages}</span>
    {page < pages ? <a rel="next" href={pageUrl(page + 1)}>下一页 →</a> : <span />}
  </nav>}
</Base>
