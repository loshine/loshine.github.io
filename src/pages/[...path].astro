---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, listingRoutes, dateLabel } from '../lib/posts';

export async function getStaticPaths() { return listingRoutes(await getPosts()); }
const { title, posts, page, pages, base } = Astro.props;
const all = await getPosts();
const isHome = base === '' && page === 1;
const pageUrl = (number: number) => number === 1 ? `/${base ? `${base}/` : ''}` : `/${base ? `${base}/` : ''}page/${number}/`;
const years = [...new Set(all.map((post) => dateLabel(post).slice(0, 4)))];
---
<Base title={isHome ? undefined : `${title}${page > 1 ? ` · 第 ${page} 页` : ''}`}>
  {isHome ? <section class="hero">
    <div>
      <p class="eyebrow">LOSHINE / DEVELOPER & WRITER</p>
      <h1>代码之外，<br />也是生活。</h1>
      <p class="hero-description">活捉一只 Android 狗。<br />记录开发中的探索、踩坑，还有一些好玩的事情。</p>
      <a class="text-link" href="/about/">关于我 <span aria-hidden="true">↗</span></a>
    </div>
    <aside class="profile-note">
      <img src="/assets/img/avatar.png" alt="Loshine 的头像" width="72" height="72" />
      <p class="eyebrow">HELLO, I'M LOSHINE</p>
      <p>Android Developer<br /><span>China, Shanghai</span></p>
      <div class="profile-topics"><span>Android</span><span>Kotlin</span><span>跨平台</span></div>
      <a href="https://github.com/loshine">在 GitHub 找到我 ↗</a>
    </aside>
  </section> : <header class="page-heading"><p class="eyebrow">THE NOTEBOOK</p><h1>{title}</h1></header>}
  <div class="section-heading"><h2>{isHome ? '最近写下的' : '文章列表'}</h2><span>{isHome ? `${all.length} 篇笔记 · 持续积累` : `第 ${page} / ${pages} 页`}</span></div>
  {base.startsWith('archives') && <nav class="archive-years" aria-label="按年份归档">{years.map((year) => <a href={`/archives/${year}/`}>{year}</a>)}</nav>}
  <PostList posts={posts} />
  {pages > 1 && <nav class="pagination" aria-label="文章分页">
    {page > 1 ? <a rel="prev" href={pageUrl(page - 1)}>← 上一页</a> : <span />}
    <span>{page} / {pages}</span>
    {page < pages ? <a rel="next" href={pageUrl(page + 1)}>下一页 →</a> : <span />}
  </nav>}
</Base>
