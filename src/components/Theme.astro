<script is:inline data-theme-script>
  (() => {
    const system = window.matchMedia('(prefers-color-scheme: dark)');
    let preference;
    const readPreference = () => {
      try {
        const stored = localStorage.getItem('theme');
        preference = stored === 'dark' || stored === 'light' ? stored : undefined;
      } catch { /* Storage may be disabled; keep the in-memory choice. */ }
    };
    const apply = () => {
      const theme = preference ?? (system.matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#1d1f21' : '#fafafa';
      document.getElementById('theme-toggle')?.setAttribute('aria-pressed', String(theme === 'dark'));
    };
    readPreference();
    apply();
    system.addEventListener('change', apply);
    window.addEventListener('pageshow', () => { readPreference(); apply(); });
    document.addEventListener('DOMContentLoaded', () => {
      const button = document.getElementById('theme-toggle');
      button.hidden = false;
      apply();
      button.addEventListener('click', () => {
        preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', preference); } catch { /* The current page can still switch. */ }
        apply();
      });
    }, { once: true });
  })();
</script>
