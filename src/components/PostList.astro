---
import { dateLabel, postPath, type Post } from '../lib/posts';
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map((post) => <article class="post-row">
    <time class="post-date" datetime={dateLabel(post)}>{dateLabel(post)}</time>
    <div class="post-info">
      <h2><a href={postPath(post)}>{post.data.title}</a></h2>
    </div>
  </article>)}
</div>
