---
interface Props { path: string; }
const { path } = Astro.props;
const repo = 'loshine/loshine.github.io';
---
<section class="comments" aria-labelledby="comments-title" data-pagefind-ignore>
  <h2 id="comments-title">聊一聊</h2>
  <p>想法、问题，或不同的解法，都欢迎留下来。使用 GitHub 账号参与讨论。</p>
  <button id="load-comments" type="button">加载评论</button>
  <p id="comments-status" role="status"></p>
  <div class="giscus"
    data-repo={repo}
    data-repo-id="MDEwOlJlcG9zaXRvcnk0MDc0ODIzMA=="
    data-category="Announcements"
    data-category-id="DIC_kwDOAm3Exs4DJ1Te"
    data-mapping="specific"
    data-term={path}
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-lang="zh-CN"
  ></div>
  <noscript><a href={`https://github.com/${repo}/discussions`}>前往 GitHub Discussions 查看评论</a></noscript>
</section>
<script>
  const button = document.querySelector<HTMLButtonElement>('#load-comments');
  const container = document.querySelector<HTMLElement>('.giscus');
  const theme = () => document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  const syncTheme = () => {
    container?.querySelector<HTMLIFrameElement>('iframe.giscus-frame')?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: theme() } } }, 'https://giscus.app',
    );
  };
  if (button && container) {
    new MutationObserver(syncTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    container.addEventListener('load', syncTheme, true);
    button.addEventListener('click', () => {
      const status = document.querySelector<HTMLElement>('#comments-status')!;
      button.disabled = true;
      status.textContent = '正在连接 giscus…';
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      Object.assign(script.dataset, container.dataset, { theme: theme() });
      script.onload = () => { button.hidden = true; status.textContent = ''; syncTheme(); };
      script.onerror = () => { script.remove(); button.disabled = false; status.textContent = '评论暂时无法加载，请稍后重试。'; };
      container.appendChild(script);
    });
  }
</script>
