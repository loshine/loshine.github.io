---
import { siteTitle, siteDescription } from '../lib/posts';
import '../styles/global.css';
import Theme from '../components/Theme.astro';

interface Props { title?: string; description?: string; article?: boolean; }
const { title, description = siteDescription, article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title ? `${title} · ${siteTitle}` : `${siteTitle} · Loshine 的技术笔记`;
const links = [['/archives/', '归档'], ['/categories/', '分类'], ['/tags/', '标签'], ['/about/', '关于']];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fafafa" />
    <Theme />
    <link rel="canonical" href={canonical} />
    {article && <meta name="giscus:backlink" content={canonical.href} />}
    <link rel="icon" type="image/png" href="/assets/img/favicon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:image" content={new URL('/assets/img/avatar.png', Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header shell">
      <a class="brand" href="/" aria-label="饭窝首页"><img src="/assets/img/cactus.svg" alt="" width="45" height="80" /><span>饭窝</span></a>
      <nav aria-label="主导航">
        {links.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
      </nav>
      <div class="header-actions">
        <a class="icon-button" href="/search/" aria-label="搜索" title="搜索"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg></a>
        <button id="theme-toggle" class="icon-button" type="button" aria-label="深色模式" aria-pressed="false" title="切换明暗主题" hidden>
          <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
          <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z" /></svg>
        </button>
      </div>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer shell">
      <span>© {new Date().getFullYear()} Loshine · 饭窝</span>
      <span>Built with <a href="https://astro.build/">Astro</a> &amp; <a href="https://github.com/chrismwilliams/astro-cactus">Cactus</a></span>
    </footer>
  </body>
</html>
